{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "companies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::company.company",
      "mappedBy": "user"
    },
    "educations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::education.education",
      "mappedBy": "user"
    },
    "experiences": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::experience.experience",
      "mappedBy": "user"
    },
    "snippets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::snippet.snippet",
      "mappedBy": "user"
    },
    "jobNotificationPreference": {
      "type": "enumeration",
      "enum": [
        "instant",
        "daily",
        "weekly"
      ],
      "default": "instant"
    },
    "jobEmailQueues": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job-email-queue.job-email-queue",
      "mappedBy": "user"
    },
    "subscriptionStatus": {
      "type": "enumeration",
      "enum": [
        "free",
        "paid"
      ],
      "default": "free"
    },
    "subscriptionId": {
      "type": "string",
      "private": true
    }
  }
}
