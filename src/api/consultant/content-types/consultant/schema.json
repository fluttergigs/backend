{
  "kind": "collectionType",
  "collectionName": "consultants",
  "info": {
    "singularName": "consultant",
    "pluralName": "consultants",
    "displayName": "Consultant",
    "description": "Flutter/Dart consultants available for interviews"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "bio": {
      "type": "text"
    },
    "avatar": {
      "type": "string"
    },
    "yearsOfExperience": {
      "type": "integer",
      "default": 0
    },
    "hourlyRate": {
      "type": "decimal"
    },
    "specialties": {
      "type": "json"
    },
    "isAvailable": {
      "type": "boolean",
      "default": true
    },
    "isPaidConsultant": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "linkedinProfile": {
      "type": "string"
    },
    "githubProfile": {
      "type": "string"
    },
    "portfolioUrl": {
      "type": "string"
    },
    "calendlyUrl": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "rating": {
      "type": "decimal",
      "default": 0.0
    },
    "totalSessions": {
      "type": "integer",
      "default": 0
    }
  }
}